{
  "name": "web",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "sync:public": "node scripts/sync-public-assets.mjs",
    "predev": "npm run sync:public",
    "dev": "next dev --turbopack",
    "prebuild": "npm run sync:public",
    "build": "node scripts/check-env.mjs && prisma generate && (prisma migrate deploy || echo '[build] prisma migrate deploy failed — continuing build') && next build",
    "start": "next start",
    "lint": "eslint",
    "postinstall": "prisma generate && (node scripts/sync-public-assets.mjs || echo '[postinstall] sync-public-assets skipped')",
    "seed": "tsx prisma/seed.ts",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy"
  },
  "dependencies": {
    "@prisma/client": "^5.22.0",
    "@supabase/ssr": "^0.12.5",
    "@supabase/supabase-js": "^2.112.4",
    "date-fns": "^4.4.0",
    "next": "15.5.23",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "15.5.23",
    "prisma": "^5.22.0",
    "tailwindcss": "^4",
    "tsx": "^4.23.12",
    "typescript": "^5"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  }
}
