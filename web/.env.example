# =============================================================================
# Bottomz Up — environment template
# Copy to web/.env for LOCAL only. On Vercel, set these in Project → Settings → Environment Variables.
# =============================================================================

# Postgres (Supabase)
DATABASE_URL="postgresql://USER:PASSWORD@HOST:6543/postgres?pgbouncer=true"
DIRECT_URL="postgresql://USER:PASSWORD@HOST:5432/postgres"

# Auth — REQUIRED
NEXTAUTH_SECRET="replace-with-long-random-string"

# Auth URL
# LOCAL:
NEXTAUTH_URL="http://localhost:3000"
# VERCEL / PRODUCTION (set in Vercel dashboard — do NOT use localhost):
# NEXTAUTH_URL="https://your-production-domain.com"
# Tip: On Vercel you can omit NEXTAUTH_URL and we fall back to https://$VERCEL_URL

# Manager seed account (npm run seed)
ADMIN_EMAIL="manager@bottomzup.local"
ADMIN_PASSWORD="change-me"

# Optional Supabase client bits
NEXT_PUBLIC_SUPABASE_URL=""
NEXT_PUBLIC_SUPABASE_ANON_KEY=""
