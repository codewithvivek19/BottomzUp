# =============================================================================
# Bottomz Up — environment template
# Local: copy to web/.env
# Hostinger: Node.js Web App → Environment variables
# =============================================================================

# Postgres (Supabase)
DATABASE_URL="postgresql://USER:PASSWORD@HOST:6543/postgres?pgbouncer=true"
DIRECT_URL="postgresql://USER:PASSWORD@HOST:5432/postgres"

# Public site URL (production) — must match the live Hostinger domain
NEXT_PUBLIC_SITE_URL="https://bottomzupbargrill.com"

# Supabase Auth (required) — set these on Hostinger AND at build time
NEXT_PUBLIC_SUPABASE_URL="https://YOUR_PROJECT.supabase.co"
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY="your-publishable-or-anon-key"
# NEXT_PUBLIC_SUPABASE_ANON_KEY="legacy-anon-key-also-ok"

# Manager allowlist (comma-separated). Must match a Supabase Auth user email.
# Example production manager:
ADMIN_EMAILS="Manager@bottomzupbargrill.com"
